modules = ["bun-1.2", "web", "bash"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Documentation Server"

[[workflows.workflow]]
name = "Documentation Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd alchemy-web && bun run docs:dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "static"
build = [
  "sh",
  "-c",
  "bun run --filter alchemy-web docs:build || echo \"ship it\"",
]
publicDir = "alchemy-web/dist"
