modules = ["bun-1.22", "web", "bash"]

[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Documentation Preview"

[[workflows.workflow]]
name = "Documentation Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd alchemy-web && bun dev --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "static"
build = [
  "sh",
  "-c",
  "PATH=\"${PATH}:/home/runner/workspace/.cache/.bun/bin\" && bash -c 'bun install -g npx && which npx && bun run --filter alchemy-web build || echo \"deploying anyway\"'",
]
publicDir = "alchemy-web/dist"
