modules = ["nodejs-20", "web", "bash"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Documentation Preview"

[[workflows.workflow]]
name = "Documentation Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd alchemy-web && bun run astro preview --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 42837
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["bun", "run", "--filter", "alchemy-web", "docs:preview", "--port", "5000", "--host", "0.0.0.0"]
build = ["bun", "run", "--filter", "alchemy-web", "docs:build"]
