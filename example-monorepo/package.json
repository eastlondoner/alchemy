{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && turbo run dev",
    "deploy": "tsc -b && turbo run deploy --ui=stream",
    "destroy": "tsc -b && turbo run destroy --ui=stream"
  },
  "type": "module",
  "packageManager": "bun@1.2.21",
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
    "alchemy": "link:alchemy",
    "@cloudflare/workers-types": "^4.20250924.0",
    "@cloudflare/vite-plugin": "^1.13.5",
    "vite": "^7.1.7",
    "typescript": "^5.9.2"
    }
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  },
  "dependencies": {
    "miniflare": "^4.20250924.0"
  }
}
